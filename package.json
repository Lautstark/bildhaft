{
  "name": "bildhaft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn German sentences into AAC pictograms, correct them, and print them. Runs entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "preflight": "node tools/installcheck.mjs",
    "test:e2e": "node tools/installcheck.mjs && npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test": "node tools/installcheck.mjs && vitest run"
  },
  "dependencies": {
    "@lautstark/bildquelle": "github:Lautstark/bildquelle#v2.2.0",
    "@lautstark/design": "github:Lautstark/design#v1.31.3",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.16.1",
    "@lautstark/werkzeuge": "github:Lautstark/werkzeuge#v1.2.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
